NODE_ENV=development
MOCK_MODE=false
APP_ROOT=.
OUTPUT_DIR=output
DATA_DIR=data
DATABASE_PATH=data/news-daily.sqlite
COLLECTION_WINDOW_HOURS=24
DEDUPE_WINDOW_HOURS=72
MODEL_PROVIDER=openai
# Optional when MODEL_PROVIDER=openai. Supports OpenAI-compatible /chat/completions APIs.
# LLM_TOKEN is also accepted as an alias for OPENAI_COMPATIBLE_API_KEY.
OPENAI_COMPATIBLE_API_KEY=
# Set the URL and model alongside that provider's key. Legacy LLM_* names also work.
# OPENAI_COMPATIBLE_BASE_URL=https://taishi.tuyoo.com/v1
# OPENAI_COMPATIBLE_MODEL=gemini-3.5-flash-lite
# For official DeepSeek use MODEL_PROVIDER=deepseek and DEEPSEEK_API_KEY.
TTS_PROVIDER=mock
MIN_AI_RELEVANCE_SCORE=50
MIN_GAME_RELEVANCE_SCORE=50
MIN_NEWS_VALUE_SCORE=55
MIN_CROSS_RELEVANCE_SCORE=60
MAX_ITEMS_PER_SOURCE=50
MAX_ITEMS_TOTAL=500
